# Advanced runtime overrides. Copy ONLY when needed to .local/config/local.auto.tfvars.
# All values below are commented: copying this template does not disable deployment.
# Public user settings belong in common.auto.tfvars and <environment>.auto.tfvars.
# Precedence: common base -> common override -> environment base -> CLI runtime
#             -> this advanced override -> environment override.
# No password, access key or token belongs in these files. Use an AWS SSO/federated role.

# Normally the CLI coordinates activation after the private database migration.
# activate_workloads = false

# The image must use an immutable digest from THIS installation's ECR repository.
# api_image = "000000000000.dkr.ecr.eu-west-1.amazonaws.com/forge/api@sha256:<64-hex-digest>"

# Generated locally from versioned source; do not commit the resulting ZIP.
# worker_archive = "/absolute/path/to/.forge/artifacts/worker.zip"

# Exact CSP hashes from the SAME Next.js export, generated by build_frontend.py.
# frontend_script_hashes = ["sha256-<base64-hash>"]

# Non-secret shared outputs. Normally written by the CLI; never mix installations.
# platform = {
#   name    = "forge"
#   region  = "eu-west-1"
#   ecr_url = "000000000000.dkr.ecr.eu-west-1.amazonaws.com/forge/api"
#   ecr_arn = "arn:aws:ecr:eu-west-1:000000000000:repository/forge/api"
#   waf_arn = "arn:aws:wafv2:us-east-1:000000000000:global/webacl/example/00000000-0000-4000-8000-000000000000"
# }
